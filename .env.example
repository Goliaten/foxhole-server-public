FLASK_PORT=8001
LOG_LEVEL=INFO



# Database Configuration
MARIADB_ROOT_PASSWORD=mysecretpassword
MARIADB_DATABASE=
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root


# SQLAlchemy Database URL
# Format: mysql+asyncmy://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="mysql+asyncmy://${MARIADB_USER}:${MARIADB_ROOT_PASSWORD}@${MARIADB_HOST}:${MARIADB_PORT}/${MARIADB_DATABASE}"
# for dockerised version of API server
DOCKER_DB_URL="mysql+asyncmy://${MARIADB_USER}:${MARIADB_ROOT_PASSWORD}@foxhole_mariadb:${MARIADB_PORT}/${MARIADB_DATABASE}"
